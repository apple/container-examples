# sample-app: one static binary that is the controller, the web UI and the sample app.
# container build -t sample-app:dev . finds this Containerfile in the context directory.
# It picks a Dockerfile first if both exist, so the repo has no Dockerfile.
# The context's .dockerignore applies to this file too.
ARG GO_VERSION=1.27
ARG BASE_IMAGE=gcr.io/distroless/static-debian12:nonroot

FROM golang:${GO_VERSION} AS build
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY} CGO_ENABLED=0
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY internal/ internal/
RUN go build -trimpath -ldflags="-s -w" -o /out/sample-app ./cmd/sample-app

FROM ${BASE_IMAGE}
COPY --from=build /out/sample-app /sample-app
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/sample-app"]
